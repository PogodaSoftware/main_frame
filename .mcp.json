{
  "mcpServers": {
    "mobile-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mobilenext/mobile-mcp@latest"
      ],
      "env": {}
    },
    "graphify": {
      "type": "stdio",
      "command": "graphify-mcp",
      "args": [
        "graphify-out/graph.json"
      ],
      "env": {}
    }
  }
}