modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "beauty"

[[workflows.workflow]]
name = "frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Frontend/portfolioResume && npm start -- --port 5000 --host 0.0.0.0"
waitForPort = 5000

[[workflows.workflow]]
name = "backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Backend/controller && python manage.py runserver 0.0.0.0:8000"
waitForPort = 8000

[[workflows.workflow]]
name = "beauty"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Frontend/beautyApp && NG_CLI_ANALYTICS=false npm start -- --port 4200 --host 0.0.0.0 --disable-host-check"
waitForPort = 4200

[[ports]]
localPort = 4200
externalPort = 4200

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5051
externalPort = 3002

[[ports]]
localPort = 5052
externalPort = 3003

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8002
externalPort = 5000

[deployment]
workingDirectory = "Frontend/portfolioResume"
deploymentTarget = "autoscale"
run = ["bash", "deploy.sh"]
build = ["bash", "-c", "cd Frontend/portfolioResume && npm install && npm run build && cd ../beautyApp && npm install && npm run build && cd ../.. && npm install && pip install -r Backend/controller/requirements.txt"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
DJANGO_DB = "sqlite"
